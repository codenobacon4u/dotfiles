let mapleader = " "

set number
set commentary
set visualbell
set clipboard+=unnamed

" Cursor motion
set scrolloff=3

" Navigation
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

nnoremap <leader>h :action PreviousTab<CR>
nnoremap <leader>l :action NextTab<CR>
nnoremap <leader>c :action CloseEditor<CR>

nnoremap <leader>m :action MoveEditorToOppositeTabGroup<CR>

nnoremap <leader>1 1gt
nnoremap <leader>2 2gt
nnoremap <leader>3 3gt
nnoremap <leader>4 4gt
nnoremap <leader>5 5gt
nnoremap <leader>6 6gt
nnoremap <leader>7 7gt
nnoremap <leader>8 8gt
nnoremap <leader>9 9gt

" Error navigation
nnoremap K :action ShowHoverInfo<CR>
nnoremap F :action ShowContextActions<CR>

nnoremap ]e :action GotoNextError<CR>
nnoremap [e :action GotoPreviousError<CR>

" Redo
nnoremap U <C-r>

inoremap <C-v> <C-r>+
"vnoremap <C-v> "+p

nnoremap <leader>s :action SearchEverywhere<CR>

nnoremap <C-F> :action FindInPath<CR>
inoremap <C-F> :action FindInPath<CR>
vnoremap <C-F> :action FindInPath<CR>

nnoremap <C-f> :action Find<CR>
inoremap <C-f> :action Find<CR>
vnoremap <C-f> :action Find<CR>
